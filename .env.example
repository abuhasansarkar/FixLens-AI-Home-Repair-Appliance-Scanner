# Convex deployment and server-only secrets (set in Convex/EAS for deployed environments)
APP_ENV=development
CONVEX_DEPLOYMENT=
CLERK_JWT_ISSUER_DOMAIN=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL_EXTRACT=gpt-5.6-luna
OPENAI_MODEL_DIAGNOSE=gpt-5.6-terra
OPENAI_MODEL_CHAT=gpt-5.6-luna
OPENAI_INPUT_USD_PER_MILLION=0
OPENAI_OUTPUT_USD_PER_MILLION=0
REVENUECAT_SECRET_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_AUTH_TOKEN=
EXPO_ACCESS_TOKEN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Backend-configurable product policy defaults
FREE_LIFETIME_DIAGNOSES=3
PRO_MONTHLY_DIAGNOSES=15
FREE_APPLIANCE_LIMIT=1
MAX_DIAGNOSIS_IMAGES=3
MAX_APPLIANCE_SCANS_PER_DAY=10
MAX_CLARIFICATION_ROUNDS=3
MAX_PRO_ASSISTANT_REPLIES=5
DIAGNOSIS_SESSION_EXPIRY_HOURS=24
MAX_IMAGE_LONG_EDGE=2048
DIAGNOSIS_START_BURST_LIMIT=5
DIAGNOSIS_DAILY_ATTEMPT_LIMIT=20
APPLIANCE_SCAN_BURST_LIMIT=4
UPLOAD_URL_BURST_LIMIT=12
CLARIFICATION_BURST_LIMIT=4
ASSISTANT_REPLY_BURST_LIMIT=6
